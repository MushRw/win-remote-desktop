{
  "settings": {
    "port": 3000,
    "cert": "desk.example.com",
    "auth": "users",
    "minify": true,
    "rendezv": true,
    "webRTC": true,
    "allowHighQualityDesktop": true,
    "_no2FactorAuth": true,
    "maxInvalidLogin": { "time": 10, "count": 20, "coolofftime": 10 },
