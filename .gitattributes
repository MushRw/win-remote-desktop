# 默认统一 LF，避免跨平台出现整文件 diff
* text=auto eol=lf

# Windows 批处理必须用 CRLF。
# 用 LF 行尾的 .bat 在 cmd.exe 里执行 label / goto 会出错。
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Unix 侧
*.sh   text eol=lf

# 文本类配置文件
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary
